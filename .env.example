# Copia questo file in .env e inserisci i valori veri.
# .env NON va committato: contiene segreti.
#
#   cp .env.example .env
#   # poi apri .env e incolla la chiave
#   set -a; source .env; set +a
#   claude          # lancialo da questa stessa cartella

# Chiave API di 21st.dev — https://21st.dev (registrazione -> API key)
API_KEY_21ST=

# Solo se userai la ricerca lead via Google (vedi prospecting/README.md)
GOOGLE_MAPS_API_KEY=
PAGESPEED_API_KEY=
