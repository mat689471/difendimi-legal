{%- comment -%}
  FIUTO — Hero
  Cinematic opening scene. Real product photography is composited into the
  layout (multiply blend on the warm surface acts as a live cut-out for the
  studio shots), with staged text reveal, pointer parallax and ambient motion.
  Every string is editable from the theme editor.
{%- endcomment -%}

{%- liquid
  assign hero_product = section.settings.product
  assign hero_collection = section.settings.collection
  assign hero_image = section.settings.image
  if hero_image == blank and hero_product != blank
    assign hero_image = hero_product.featured_image
  endif

  assign min_price = 0
  assign count = 0
  if hero_collection != blank
    assign count = hero_collection.all_products_count
    for p in hero_collection.products limit: 50
      if min_price == 0 or p.price < min_price
        assign min_price = p.price
      endif
    endfor
  endif
-%}

<section
  class="f-hero f-section"
  id="fiuto-hero-{{ section.id }}"
  data-f-overhero
  style="--f-hero-min: {% if section.settings.height == 'full' %}100svh{% else %}88svh{% endif %};"
>
  <div class="f-hero__bg" aria-hidden="true">
    <span class="f-hero__glow f-hero__glow--a"></span>
    <span class="f-hero__glow f-hero__glow--b"></span>
    <span class="f-grain-layer"></span>
  </div>

  <div class="f-wrap f-wrap--wide f-hero__inner">
    <div class="f-hero__copy">
    <div class="f-hero__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="f-eyebrow f-hero__eyebrow" data-f-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="f-mega f-hero__title f-reveal-text" data-f-split="52">{{ section.settings.heading }}</h1>
    </div>

    <div class="f-hero__tail">
      {%- if section.settings.subheading != blank -%}
        <div class="f-lead f-hero__lead" data-f-reveal style="--f-delay: 260ms;">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}

      <div class="f-hero__actions" data-f-stagger="90">
        {%- if section.settings.cta_label != blank -%}
          <a
            class="f-btn f-btn--amber"
            href="{{ section.settings.cta_link | default: '#' }}"
            data-f-reveal
            data-f-magnet="0.16"
          >
            {{ section.settings.cta_label }}
            <span class="f-btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="f-btn f-btn--ghost" href="{{ section.settings.cta2_link | default: '#' }}" data-f-reveal>
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>

      <dl class="f-hero__stats" data-f-stagger="70">
        {%- if count > 0 -%}
          <div class="f-hero__stat" data-f-reveal>
            <dt class="f-num">{{ count }}</dt>
            <dd>{{ section.settings.stat_products_label }}</dd>
          </div>
        {%- endif -%}
        {%- if min_price > 0 -%}
          <div class="f-hero__stat" data-f-reveal>
            <dt class="f-num">{{ min_price | money_without_trailing_zeros }}</dt>
            <dd>{{ section.settings.stat_price_label }}</dd>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_free_value != blank -%}
          <div class="f-hero__stat" data-f-reveal>
            <dt class="f-num">{{ section.settings.stat_free_value }}</dt>
            <dd>{{ section.settings.stat_free_label }}</dd>
          </div>
        {%- endif -%}
      </dl>
    </div>

    </div>

    <div class="f-hero__stage">
      {%- if section.settings.show_rings -%}
        <span class="f-hero__rings" aria-hidden="true"><i></i><i></i><i></i></span>
      {%- endif -%}

      <figure class="f-hero__media f-float" data-f-parallax="-16" data-f-reveal="scale">
        {%- if hero_image != blank -%}
          <img
            src="{{ hero_image | image_url: width: 1400 }}"
            srcset="
              {{ hero_image | image_url: width: 600 }} 600w,
              {{ hero_image | image_url: width: 900 }} 900w,
              {{ hero_image | image_url: width: 1400 }} 1400w
            "
            sizes="(min-width: 990px) 46vw, 88vw"
            alt="{{ hero_image.alt | default: hero_product.title | escape }}"
            width="{{ hero_image.width }}"
            height="{{ hero_image.height }}"
            fetchpriority="high"
            decoding="async"
            class="f-hero__img"
          >
        {%- else -%}
          <div class="f-hero__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </figure>

      {%- if hero_product != blank -%}
        <a
          class="f-hero__chip f-hero__chip--product"
          href="{{ hero_product.url }}"
          data-f-parallax="-34"
          data-f-reveal
          style="--f-delay: 620ms;"
        >
          <span class="f-hero__chip-media">
            <img
              src="{{ hero_product.featured_image | image_url: width: 160 }}"
              alt=""
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
            >
          </span>
          <span class="f-hero__chip-text">
            <strong>{{ hero_product.title | split: '—' | first | strip | truncate: 26 }}</strong>
            <em>{{ hero_product.price | money }}</em>
          </span>
          <span class="f-hero__chip-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}

      {%- if section.settings.tag_label != blank -%}
        <span class="f-hero__chip f-hero__chip--tag" data-f-parallax="-48" data-f-reveal style="--f-delay: 760ms;">
          <span class="f-hero__pulse" aria-hidden="true"></span>
          {{ section.settings.tag_label }}
        </span>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.scroll_target != blank -%}
    <a class="f-hero__scroll" href="{{ section.settings.scroll_target }}">
      <span class="f-hero__scroll-label">{{ section.settings.scroll_label }}</span>
      <span class="f-hero__scroll-line" aria-hidden="true"></span>
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Fiuto · Hero",
  "tag": "section",
  "class": "fiuto-section fiuto-section--hero",
  "settings": [
    { "type": "header", "content": "Contenuto" },
    { "type": "text", "id": "eyebrow", "label": "Occhiello", "default": "Enrichment per cani" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Il naso è il gioco." },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Testo",
      "default": "<p>Il tuo cane distrugge casa quando si annoia? Tappetini olfattivi, lick mat e dispenser che trasformano la pappa in una caccia al tesoro.</p>"
    },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Immagine principale" },
    { "type": "product", "id": "product", "label": "Prodotto in evidenza" },
    { "type": "collection", "id": "collection", "label": "Collezione (per i dati)" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Bottone primario", "default": "Scopri i giochi" },
    { "type": "url", "id": "cta_link", "label": "Link primario" },
    { "type": "text", "id": "cta2_label", "label": "Bottone secondario", "default": "Come funziona" },
    { "type": "url", "id": "cta2_link", "label": "Link secondario" },
    { "type": "header", "content": "Dati in evidenza" },
    { "type": "text", "id": "stat_products_label", "label": "Etichetta n° prodotti", "default": "giochi olfattivi" },
    { "type": "text", "id": "stat_price_label", "label": "Etichetta prezzo", "default": "prezzo di partenza" },
    { "type": "text", "id": "stat_free_value", "label": "Valore terzo dato", "default": "5–20" },
    { "type": "text", "id": "stat_free_label", "label": "Etichetta terzo dato", "default": "minuti di gioco per sessione" },
    { "type": "header", "content": "Etichetta fluttuante" },
    { "type": "text", "id": "tag_label", "label": "Testo etichetta", "default": "Naso al lavoro" },
    { "type": "header", "content": "Aspetto e motion" },
    {
      "type": "select",
      "id": "height",
      "label": "Altezza",
      "options": [
        { "value": "full", "label": "Schermo intero" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "full"
    },
    { "type": "checkbox", "id": "show_rings", "label": "Onde olfattive animate", "default": true },
    { "type": "text", "id": "scroll_label", "label": "Testo indicatore scroll", "default": "Scorri" },
    { "type": "url", "id": "scroll_target", "label": "Ancora indicatore scroll" }
  ],
  "presets": [{ "name": "Fiuto · Hero" }]
}
{% endschema %}
