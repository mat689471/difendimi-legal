# Copia questo file in "jarvis/.env" e incolla la tua chiave.
# Il file jarvis/.env è escluso da Git: la tua chiave resta solo sul tuo computer.
#
#   cp jarvis/.env.example jarvis/.env
#   poi apri jarvis/.env e incolla la chiave qui sotto
#
# La chiave la prendi da: https://console.anthropic.com  →  API Keys.
# (È a consumo, fatturata a parte rispetto all'abbonamento Claude.)

ANTHROPIC_API_KEY=sk-ant-la-tua-chiave-qui
